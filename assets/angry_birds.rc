#include <winver.h>

#define IDI_APP 101

IDI_APP ICON "../installer/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Shohail Mahmud"
            VALUE "FileDescription", "Angry Birds 1.2.0 - Rust rebuild"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "AngryBirds_1.2.0"
            VALUE "LegalCopyright", "MIT for the code. Original game (c) Rovio Entertainment."
            VALUE "OriginalFilename", "AngryBirds_1.2.0.exe"
            VALUE "ProductName", "Angry Birds 1.2.0 (Rust rebuild)"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
